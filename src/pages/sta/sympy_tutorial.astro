[&#123;x: -2, y: 1&#125;, &#123;x: 1, y: -2&#125;, &#123;x: -3 + (1/2 - sqrt(13)/2)**2, y: 1/2 - sqrt(13)/2&#125;, &#123;x: -3 + (1/2 + sqrt(13)/2)**2, y: 1/2 + sqrt(13)/2&#125;]
    </pre>
  </SubSection>

