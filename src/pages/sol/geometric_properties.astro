    <DisplayTable class_="text-center" id="inertia-table">
        <thead>
            <tr>
                <th class="nosideborderleft">
                    
                </th>
                <th>
                    <strong>Mass moment of inertia</strong>
                </th>
                <th class="table-shaded" colspan="3">
                    <strong>Area moment of inertia (used in solid mechanics!)</strong>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>

                <td class="nosideborderleft">
                    <strong>Other names</strong>
                </td>
                    
                <td>
                    
                </td>

                <td class="table-shaded">First moment of area</td>
                <td class="table-shaded">Second moment of area</td>
                <td class="table-shaded">Polar moment of area</td>


            </tr>
            <tr>
                <td class="nosideborderleft">
                    <strong>Description</strong>
                </td>
                <td>
                    Determines the torque needed to produce a desired angular rotation about an axis of rotation (resistance to rotation)
                </td>
                <td class = "table-shaded">Determines the centroid of an area </td>
                <td class = "table-shaded">
                    Determines the moment needed to produce a desired curvature about an axis(resistance to bending)
                </td>
                <td class = "table-shaded">Determines the torque needed to produce a desired twist a shaft or beam(resistance to torsion) </td>
                
            </tr>
            <tr>
                <td class="nosideborderleft">
                    <strong>Equations</strong>
                </td>
                <td>
                    <DisplayEquation equation='I_{P,\\hat{a}} = \\iiint_\\mathcal{B} \\rho r^2 \\,dV\\' /> 
                </td>
                <td class = "table-shaded">
                    <DisplayEquation equation="Q_z = \\int_A y dA = \\Sigma yA" />
                    <DisplayEquation equation="Q_y = \\int_A z dA  = \\Sigma zA" />
                    <DisplayEquation equation="\\bar{y} = \\frac{1}{A}\\int_A y dA" />
                    <DisplayEquation equation="\\bar{z} = \\frac{1}{A}\\int_A z dA" />
                </td>
                <td class = "table-shaded">
                    <DisplayEquation equation='I_x = \\int_{A}^{} y^2 \\,dA \\' />
                    <DisplayEquation equation='I_y = \\int_{A}^{} x^2 \\,dA \\' />
                </td>
                <td class = "table-shaded">
                    <DisplayEquation equation='\\begin{aligned} J_O &= \\int_{A}^{} r^2 \\,dA \\\\ &= \\int_{A}^{} (x^2+y^2) \\,dA\\ \\end{aligned}' />
                </td>
            </tr>
            <tr>
                <td class="nosideborderleft">
                    <strong>Units</strong> 
                </td>
