                    <InlineEquation equation="\\mathrm{mass} \\ \\mathrm{length} ^ 2"/>
                </td>
                <td class = "table-shaded">
                    <InlineEquation equation="\\mathrm{length} ^ 3"/>
                </td>
                <td class = "table-shaded">
                    <InlineEquation equation="\\mathrm{length} ^ 4"/>
                </td>
                <td class = "table-shaded">
                    <InlineEquation equation="\\mathrm{length} ^ 4"/>
                </td>
            </tr>
            <tr>
                <td class="nosideborderleft">
                    <strong>Typical Equations</strong>
                </td>
                <td>
                    <DisplayEquation equation='\\tau = I\\alpha' /> 
                </td>
                <td class = "table-shaded">
                    <DisplayEquation equation='\\tau = \\frac{VQ}{It}' /> 
                </td>
                <td class = "table-shaded">
                    <DisplayEquation equation='\\sigma = \\frac{My}{I}' />
                    <DisplayEquation equation='\\tau = \\frac{VQ}{It}' /> 
                </td>
                <td class = "table-shaded">
