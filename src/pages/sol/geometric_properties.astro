                    <Image src='/sol/bending/CommonShapes_Circle.png' width='5'> </Image>
                </td>
            <td style="vertical-align: middle">
                <InlineEquation equation="\\bar{I}_x = \\bar{I}_y  = \\frac{1}{4} \\pi r^4" />
                <br>
                <br>
                <InlineEquation equation="J_O= \\frac{1}{2} \\pi r^4"/>    
            </td>
            </tr>
        </tbody>
        <tbody>
            <tr>
                <td class="nosideborderleft" style="vertical-align: middle">
                    Semicircle
                </td>
                <td>
                    <Image src='/sol/bending/CommonShapes_Semi.png' width='5'> </Image>
                </td>
            <td style="vertical-align: middle">
                <InlineEquation equation="I_x = I_y = \\frac{1}{8} \\pi r^4" />
                <br>
                <br>
                <InlineEquation equation="J_O = \\frac{1}{4} \\pi r^4"/>    
            </td>
            </tr>
        </tbody>
        <tbody>
            <tr>
                <td class="nosideborderleft" style="vertical-align: middle">
                    Quarter circle
                </td>
                <td>
                    <Image src='/sol/bending/CommonShapes_Quart.png' width='5'> </Image>
                </td>
