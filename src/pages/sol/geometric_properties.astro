                </td>
            <td style="vertical-align: middle">
                <InlineEquation equation="\\bar{I}_{x'} = \\frac{1}{12}b h^3" />    
                <br>
                <br>
                <InlineEquation equation="\\bar{I}_{y'} = \\frac{1}{12}b^3 h" />
                <br>
                <br>
                <InlineEquation equation="I_x = \\frac{1}{3}b h^3"/>
                <br>
                <br>
                <InlineEquation equation="I_y = \\frac{1}{3}b^3 h"/>
                <br>
                <br>
                <InlineEquation equation="J_c = \\frac{1}{12}bh(b^2+h^2)"/>
            </td>
            </tr>
        </tbody>
        <tbody>
            <tr>
                <td class="nosideborderleft" style="vertical-align: middle">
                    Triangle
                </td>
                <td>
                    <Image src='/sol/bending/CommonShapes_Tri.png' width='5'> </Image>
                </td>
            <td style="vertical-align: middle">
                <InlineEquation equation="\\bar{I}_{x'} = \\frac{1}{36}bh^3" />
                <br>
                <br>
                <InlineEquation equation="I_x = \\frac{1}{12}bh^3" />    
            </td>
            </tr>
        </tbody>
        <tbody>
            <tr>
                <td class="nosideborderleft" style="vertical-align: middle">
                    Circle
