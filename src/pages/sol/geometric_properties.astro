                </td>
            </tr>
            <tr>
                <td class="nosideborderleft">
                    <strong>Courses</strong>
                </td>
                <td>
                    Dynamics
                </td>
                <td class = "table-shaded">
                    Solid mechanics
                </td>
                <td class = "table-shaded">
                    Statics, solid mechanics
                </td>
                <td class = "table-shaded">
                    Solid mechanics
                </td>
            </tr>
        </tbody>
    </DisplayTable>
