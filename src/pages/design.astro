---
import Layout from "../layouts/CourseMenuLayout.astro"
import Section from "../components/Section.astro"
import SubSection from "../components/SubSection.astro"
import Image from "../components/Image.astro"
import "../../public/static/css/course_home_pages.css"
---

<style>
       h2 {
              font-weight: 700;
              letter-spacing: -0.7px;
       }
       .small-img {
              width: 120px;
              height: 120px;
       }
       .border-orange {
              border: 6px solid #C84113;
       }
       .border-blue {

               border: 6px solid #13294B;

       }

</style>


<Layout title="Design">

  <h1>
    <strong>Design</strong>
  </h1>

  <section class="mt-sm-4 mt-2">
    <ol>
      <li><a href="/design/design_process?origin=coursemenu">Design Process</a></li>
      <li><a href="/design/identify_need?origin=coursemenu">Identify Needs</a></li>
      <li><a href="/design/pds?origin=coursemenu">Product Design Specification (PDS)</a></li>
      <li><a href="/design/design_ideas?origin=coursemenu">Generate Design Ideas</a></li>
      <li><a href="/design/detail_design?origin=coursemenu">Detail Design</a></li>
      <li><a href="/design/analyze_and_select_design?origin=coursemenu">Analyze and Select</a></li>
      <li><a href="/design/metal_casting?origin=coursemenu">Metal Casting</a></li>
      <li><a href="/design/machining?origin=coursemenu">Machining</a></li>
      <li><a href="/design/additive_manufacturing?origin=coursemenu">Additive Manufacturing</a></li>
