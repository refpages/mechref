          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/transverse_shear#shear_flow'>Built-up Members/Beams: Shear Flow</a></li> 
        </ul>
      </CourseCard>  

      <CourseCard href="/sol/combined_loading" img_src="/sol/home_page/combined_loading.png" title="Combined loading">
        <ul class='list-group list-group-flush py-0'> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/combined_loading#load-summary'>Types of Loading Summary</a></li>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/combined_loading#stress'>Stress Under Combined Loads</a></li>  
        </ul>
      </CourseCard> 

      <CourseCard href="/sol/thermal_loading" img_src="/sol/home_page/pressure_vessels.png" title="Thermal Loading">
        <ul class='list-group list-group-flush py-0'> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/pressure_vessels#thin-walled-pressure-vessels'>Thin-Walled Pressure Vessels</a>
          
            <ul class='list-group list-group-flush py-0'> 
               
            </ul>
          </li>
        </ul>
      </CourseCard>

      <CourseCard href="/sol/superposition" img_src="/sol/home_page/stress_transformation.png" title="Principle of Superposition">
        <ul class='list-group list-group-flush py-0'> 
        </ul>
      </CourseCard> 
      
      <CourseCard href="/sol/statically_indeterminate_problems" img_src="/sol/home_page/failure_theories.png" title="Statically Indeterminate Problems">
        <ul class='list-group list-group-flush py-0'> 
        </ul>
      </CourseCard> 

      <CourseCard href="/sol/failure_engineering_materials" img_src="/sol/home_page/beam_deflection.png" title="Failure of Engineering Materials">
        <ul class='list-group list-group-flush py-0'> 
        </ul>
      </CourseCard> 

      <CourseCard href="/sol/design_considerations" img_src="/sol/home_page/buckling.png" title="Design Considerations">
        <ul class='list-group list-group-flush py-0'> 
        </ul>
      </CourseCard> 

      <CourseCard href="/sol/appendix" img_src="/sol/home_page/buckling.png" title="Appendix">
        <ul class='list-group list-group-flush py-0'> 
        </ul>
      </CourseCard> 

      <li slot="list"><a href="/sol/intro?origin=coursemenu">Intro</a></li>
      <li slot="list"><a href="/sol/strain?origin=coursemenu">Strain</a></li>
      <li slot="list"><a href="/sol/stress?origin=coursemenu">Stress</a></li>
      <li slot="list"><a href="/sol/material_properties?origin=coursemenu">Material properties</a></li>
      <li slot="list"><a href="/sol/simple_loading?origin=coursemenu">Simple loading</a></li>
      <li slot="list"><a href="/sol/combined_loading?origin=coursemenu">Combined loading</a></li>
      <li slot="list"><a href="/sol/superposition?origin=coursemenu">Principle of Superposition</a></li>
      <li slot="list"><a href="/sol/statically_indeterminate_problems?origin=coursemenu">Statically Indeterminate Problems</a></li>
      <li slot="list"><a href="/sol/failure_engineering_materials?origin=coursemenu">Failure of Engineering Materials</a></li>
      <li slot="list"><a href="/sol/design_considerations?origin=coursemenu">Design Considerations</a></li>
      <li slot="list"><a href="/sol/appendix?origin=coursemenu">Appendix</a></li>
    </SimplifiedView>
  </div>


