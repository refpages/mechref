        <ul class='list-group list-group-flush py-0'>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/shear_moment_diagrams#shear_moment_diagrams'>Internal Forces</a></li>  
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/shear_moment_diagrams#sign_conventions'>Sign Conventions</a></li> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/shear_moment_diagrams#general_procedure'>General Procedure</a></li>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/shear_moment_diagrams#general_rules'>General Rules</a></li>
        </ul>
      </CourseCard> 

      <CourseCard href="/sol/bending" img_src="/sol/bending/Geometry.png" title="Bending">
        <ul class='list-group list-group-flush py-0'> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/bending#sign-conventions'>Sign Conventions</a></li>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/bending#boundary-conditions'>Boundary Conditions</a></li> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/bending#pure-bending'>Pure Bending</a></li> 
