---
import Layout from "../layouts/CourseMenuLayout.astro"
import Section from "../components/Section.astro"
import SubSection from "../components/SubSection.astro"
import Image from "../components/Image.astro"
import SimplifiedView from "../components/course_menus/SimplifiedView.astro"
import CourseCard from "../components/course_menus/CourseCard.astro"

import "../../public/static/css/course_home_pages.css"
---


<Layout title="Solid mechanics">
  <h1>
    <strong>Solid mechanics</strong>
  </h1>
  <section class="mt-sm-4 mt-2">
    <ol>
      <li><a href="/sol/stress?origin=coursemenu">Stress</a></li>
      <li><a href="/sol/strain?origin=coursemenu">Strain</a></li>
      <li><a href="/sol/material_properties?origin=coursemenu">Material properties</a></li>
      <li><a href="/sol/axial_loading?origin=coursemenu">Axial loading</a></li>
      <li><a href="/sol/torsion?origin=coursemenu">Torsion</a></li>
      <li><a href="/sol/shear_moment_diagrams?origin=coursemenu">Shear moment diagrams</a></li>
      <li><a href="/sol/bending?origin=coursemenu">Bending</a></li>
      <li><a href="/sol/transverse_shear?origin=coursemenu">Transverse shear</a></li>
      <li><a href="/sol/pressure_vessels?origin=coursemenu">Pressure vessels</a></li>
      <li><a href="/sol/combined_loading?origin=coursemenu">Combined loading</a></li>
      <li><a href="/sol/stress_transformation?origin=coursemenu">Stress transformation</a></li>
      <li><a href="/sol/failure_theories?origin=coursemenu">Failure theories</a></li>
      <li><a href="/sol/beam_deflection?origin=coursemenu">Beam deflection</a></li>
      <li><a href="/sol/buckling?origin=coursemenu">Buckling</a></li>
    </ol>
  </section>

  <div style="height:40px"></div>
  <h2 class="site-title">Faculty Authors:</h2>
  <div style="height:10px"></div>

  <div>
      <ul class="list-unstyled d-flex flex-wrap text-center mb-1 ml-4">
              <li class="me-4 text-center">
                    <a href="https://grainger.illinois.edu/about/directory/faculty/tfg">
                    <img class="border-orange small-img rounded-circle" src="https://ws.engr.illinois.edu/directory/viewphoto.aspx?photo=19205&s=300" />
                    </a>
                    <h2 style="font-size:20px" class="site-title mt-2">Tom Golecki</h2>
              </li>
              <li class="me-5 text-center">
                    <a href="https://grainger.illinois.edu/about/directory/faculty/cluetke">
                    <img class="border-orange small-img rounded-circle" src="https://ws.engr.illinois.edu/directory/viewphoto.aspx?photo=16811&s=300" />
                    </a>
                    <h2 style="font-size:20px" class="site-title mt-2">Callan Luetkemeyer</h2>
              </li>
      </ul>
  </div>
  <div style="height:20px"></div>

  <div>
    <h2 style="font-size:25px" class="site-title"> Student Authors: </h2>
    <ul>
      <li> <h2 style="font-size:20px;" class="site-title">Mikayla Hoyle</h2> </li>
      <li> <h2 style="font-size:20px;" class="site-title">Chris Raymond-Bertrand</h2> </li>
    </ul>
  </div>

  <div style="height:20px"></div>

</Layout>


<style>
      h2 {
            font-weight: 700;
            letter-spacing: -0.7px;
      }
      .small-img {
            width: 120px;
            height: 120px;
      }
      .border-orange {
            border: 6px solid #C84113;
      }
      .border-blue {

            border: 6px solid #13294B;

      }
</style>