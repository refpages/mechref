---
import Layout from "../layouts/CourseMenuLayout.astro"
import Section from "../components/Section.astro"
import SubSection from "../components/SubSection.astro"
import Image from "../components/Image.astro"
import SimplifiedView from "../components/course_menus/SimplifiedView.astro"
import CourseCard from "../components/course_menus/CourseCard.astro"

import "../../public/static/css/course_home_pages.css"
---


<Layout title="Solid mechanics">

  <div class="mt-sm-4 mt-2">
    <SimplifiedView id="here" title="Solid mechanics" title_style="h1 fw-bold" style="enumerate">
      
      <CourseCard href="/sol/intro" img_src="/sol/home_page/strain.png" title="Introduction">
        <ul class='list-group list-group-flush py-0'> 
        </ul>
      </CourseCard>
      
      <CourseCard href="/sol/strain" img_src="/sol/home_page/strain.png" title="Strain">
        <ul class='list-group list-group-flush py-0'> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/strain#units'>Units</a></li>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/strain#normal_strain'>Normal Strain</a>
              <ul class='list-group list-group-flush py-0'> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/strain#average_normal_(extensional)_strain'>Average Normal (extensional) Strain</a></li> 
              </ul>
          </li> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/strain#shear_strain'>Shear Strain</a>
              <ul class='list-group list-group-flush py-0'> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/strain#average_normal_(extensional)_strain'>Average Shear Strain</a></li> 
              </ul>
          </li> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/strain#strain_tensor'>Strain Tensor</a></li> 
          
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/strain#measurement_of_strain'>Measurement of Strain</a>
              <ul class='list-group list-group-flush py-0'> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/strain#direct_measurement'>Direct Measurement</a></li>
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/strain#contact_extensometer'>Contact Extensometer</a></li>
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/strain#electrical_resistance_strain_gauges'>Electrical Resistance Strain Gauges</a></li>
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/strain#vibrating_wire_strain_gauge'>Vibrating Wire Strain Gauge</a></li>
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/strain#digital_image_correlation_(dic)'>Digital Image Correlation (DIC)</a></li>
              </ul>
          </li>
        </ul>
      </CourseCard>
      
      <CourseCard href="/sol/stress" img_src="/sol/stress/Stress Element.png" title="Stress">
        <ul class='list-group list-group-flush py-0'> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/stress#units'>Units</a></li>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/stress#stress_under_general_loading_conditions'>Stress under general loading conditions</a>
              <ul class='list-group list-group-flush py-0'> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/stress#average_normal_stress_-_axial_loading'>Average Normal Stress - Axial Loading</a></li> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/stress#average_shear_stress'>Average Shear Stress</a></li> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/stress#stress_tensor'>Stress Tensor</a></li> 
              </ul>
          </li> 
          
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/stress#support_reactions'>Support Reactions</a></li>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/stress#allowable_strength_design'>Allowable Strength Design</a></li> 
        </ul>
      </CourseCard>

      <CourseCard href="/sol/material_properties" img_src="/sol/home_page/material_properties.png" title="Material properties">
        <ul class='list-group list-group-flush py-0'> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/material_properties#stress-strain_diagram'>Stress-Strain Diagram</a>
              <ul class='list-group list-group-flush py-0'> 
