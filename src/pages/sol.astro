              <ul class='list-group list-group-flush py-0'> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/material_properties#directional_materials'>Directional Materials</a></li>
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href="/sol/material_properties#poissons_ratio">Poisson's Ratio</a></li>
              </ul>
          </li> 
        </ul>
      </CourseCard> 

      <CourseCard href="/sol/simple_loading" img_src="/sol/home_page/axial_loading.png" title="Simple loading">
        <ul class='list-group list-group-flush py-0'> 
            
        </ul>
      </CourseCard> 

      <CourseCard href="/sol/torsion" img_src="/sol/torsion/TorsionLines.png" title="Torsion">
        <ul class='list-group list-group-flush py-0'> 
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/torsion#units'>Units</a></li>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/torsion#notation_and_convention'>Notation and Convention</a></li>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/torsion#equilibrium'>Equilibrium</a>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/torsion#assuptions'>Assumptions</a>
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/torsion#shear_stress_and_strain'>Shear Stress and Strain</a>
              <ul class='list-group list-group-flush py-0'> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/torsion#geometry_of_deformation'>Shear Strain: Geometry of Deformation</a></li> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/torsion#torsion_formula'>Shear Stress: Torsion Formula</a></li> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/torsion#polar_moment_of_inertia'>Shear Stress: Polar Moment of Inertia</a></li> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/torsion#angle_of_twist'>Shear Stress: Angle of Twist</a></li> 
              </ul>
          </li> 
          
          <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='/sol/torsion#miscellaneous'>Miscellaneous</a></li>
              <ul class='list-group list-group-flush py-0'> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/torsion#types_of_material_failure'>Types of Material Failure</a></li> 
                  <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='/sol/torsion#gear_systems'>Gear Systems</a></li> 
              </ul>
          </li> 
        </ul>
      </CourseCard> 

