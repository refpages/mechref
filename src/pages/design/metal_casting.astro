<!-- ===================== CHVORINOV ===================== -->

<SubSubSubSection title="Chvorinov's Rule" id="Chvorinov's Rule">

<p>The total solidification time depends on casting size and shape:</p>

<DisplayEquation equation="t_{TS} = C_m \\left(\\frac{V}{A}\\right)^n" />

<Itemize>
<Item><InlineEquation equation="t_{TS}" /> = solidification time</Item>
<Item><InlineEquation equation="V" /> = volume</Item>
<Item><InlineEquation equation="A" /> = surface area</Item>
<Item><InlineEquation equation="n \\approx 2" /></Item>
<Item><InlineEquation equation="C_m" /> = mold constant</Item>
</Itemize>

</SubSubSubSection>

<!-- ===================== SOLIDIFICATION TIME ===================== -->

<SubSubSection title="Example Problem: Solidification Time" id="Example Problem: Solidification Time">

<DisplayEquation equation="t_{TS} = 640\\ \\text{s} \\approx 10.7\\ \\text{min}" />

</SubSubSection>

