          <li class = "list-group-item py-0"><a class = "text-decoration-none subsubsection" href = "#trigonometric_functions">Trigonometric functions</a></li>
          <li class = "list-group-item py-0"><a class = "text-decoration-none subsubsection" href = "#inverse_trigonometric_functions">Inverse trigonometric functions</a></li>
